{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Radar IA (Streamlit)",
      "type": "shell",
      "command": "streamlit run app.py --server.address=0.0.0.0 --server.port=8501",
      "options": { "cwd": "${workspaceFolder}/radar_ia" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Pruebas Radar IA (pytest)",
      "type": "shell",
      "command": "python -m pytest -v",
      "options": { "cwd": "${workspaceFolder}/radar_ia" },
      "problemMatcher": []
    },
    {
      "label": "Cargar opiniones de ejemplo",
      "type": "shell",
      "command": "python cargar_ejemplos.py",
      "options": { "cwd": "${workspaceFolder}/radar_ia" },
      "problemMatcher": []
    }
  ]
}